# ── Database (PostgreSQL 15+; Neon via Vercel Marketplace injects these automatically) ──
DATABASE_URL=postgresql://rms:rms_local_dev@localhost:5432/csc_rms
# Direct (non-pooled) connection for migrations / bulk COPY. Optional locally.
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ──
# Generate: openssl rand -base64 32   (BETTER_AUTH_SECRET is accepted as an alias)
AUTH_SECRET=replace-with-32+-random-bytes
# Public base URL. Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL).
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated roles that must enrol TOTP 2FA before using the app (optional)
REQUIRE_2FA_ROLES=

# ── File storage ──
# local  = files under STORAGE_LOCAL_DIR (dev / on-prem NAS)
# blob   = Vercel Blob private store (needs BLOB_READ_WRITE_TOKEN or Vercel OIDC + BLOB_STORE_ID)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
BLOB_READ_WRITE_TOKEN=

# ── OCR worker (on-prem) ──
# Shared secret the Python worker sends as "Authorization: Bearer <token>". openssl rand -hex 32
WORKER_TOKEN=replace-with-random-hex
# Pages with OCR confidence below this (0-100) go to the QA review queue
OCR_REVIEW_THRESHOLD=80

# ── Seeding (local/demo only) ──
SEED_DEMO_PASSWORD=ChangeMe!2026
# Optional folder of public csc.gov.ph PDFs to ingest as real sample text
SAMPLES_DIR=

# ── UI ──
# 1 = show demo account hints on the login page (never in production with real data)
NEXT_PUBLIC_DEMO_MODE=
# Optional self-hosted tesseract.js language data (default: jsDelivr @tesseract.js-data, eng + fil)
NEXT_PUBLIC_TESSDATA_URL=
